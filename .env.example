
ASPNETCORE_ENVIRONMENT=Production

ConnectionStrings__DefaultConnection=Host=ep-broad-waterfall-b5lgv1ma-pooler.c-7.us-east-2.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=YOUR_NEON_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;

Jwt__Secret=YOUR_VERY_LONG_AND_SECURE_SECRET_AT_LEAST_32_CHARACTERS
Jwt__Issuer=StreamBackend
Jwt__Audience=StreamApp
Jwt__AccessTokenExpirationMinutes=60
Jwt__RefreshTokenExpirationDays=30

EnableSwagger=true

# Music Providers Configuration:
# - Invidious: Active by default with public instances (e.g. https://invidious.f5.si). Acts as YouTube audio stream proxy without getting blocked on Render.
# INVIDIOUS_INSTANCE=https://invidious.f5.si
# - Cobalt: Active by default with community extraction instances.
# COBALT_API_URL=https://api.cobalt.tools
# COBALT_API_KEY=your_optional_cobalt_key
# - Audius: Active by default, no configuration needed.
# - YouTube on Render (Optional bypass options if datacenter IP is blocked by YouTube):
# YOUTUBE_COOKIES=VISITOR_INFO1_LIVE=...; PREF=...; LOGIN_INFO=...
# YOUTUBE_PROXY=http://proxy-user:proxy-password@proxy-host:port
# - Jamendo (Optional, if you have a developer client id):
# JAMENDO_CLIENT_ID=your_jamendo_client_id
